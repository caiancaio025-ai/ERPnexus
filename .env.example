# Ambiente: development | test | production
APP_ENV=development

# PostgreSQL local
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://nexus:change-this-local-password@127.0.0.1:5433/nexus
DATABASE_URL_DOCKER=postgresql+psycopg://nexus:change-this-local-password@db:5432/nexus
# Pool de conexões PostgreSQL
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# Aplicações locais
API_PORT=8000
WEB_PORT=5173
SITE_PORT=4321
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
CORS_ORIGINS=http://localhost:5173
SESSION_HOURS=12
SESSION_COOKIE_NAME=nexus_session

# Proteção contra força bruta no login
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_IDENTIFIER_FAILURES=5
LOGIN_RATE_LIMIT_IP_FAILURES=20
LOGIN_RATE_LIMIT_RETENTION_SECONDS=86400

# Proteção da consulta pública de rastreamento
TRACKING_RATE_LIMIT_WINDOW_SECONDS=60
TRACKING_RATE_LIMIT_IP_REQUESTS=60
TRACKING_RATE_LIMIT_RETENTION_SECONDS=3600

STORAGE_ROOT=/app/storage
TRACKING_BASE_URL=http://localhost:8000/e

# Produção / Caddy
SITE_DOMAIN=example.com.br
APP_DOMAIN=app.example.com.br
ACME_EMAIL=admin@example.com.br

# Opcional. Não versionar chave real.
GEMINI_API_KEY=
