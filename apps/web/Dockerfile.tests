FROM node:22-alpine
WORKDIR /app/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web .
COPY testes_instalador /app/testes_instalador
CMD ["sh", "-c", "npm test && npm run build && node /app/testes_instalador/test_v26_painel_preferencias.cjs && node /app/testes_instalador/test_v27_temas_comemorativos.cjs && node /app/testes_instalador/test_v29_decoracao_premium.cjs"]
