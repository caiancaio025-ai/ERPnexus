:8080 {
  encode zstd gzip

  # Keep the browser on the same origin for secure session cookies.
  handle_path /api/* {
    reverse_proxy api:8000 {
      transport http {
        dial_timeout 5s
        response_header_timeout 120s
      }
    }
  }

  handle {
    root * /srv
    @versioned_assets path /assets/*
    header @versioned_assets Cache-Control "public, max-age=31536000, immutable"
    @entry_points not path /assets/*
    header @entry_points Cache-Control "no-store"
    try_files {path} /index.html
    file_server
  }
}
