---
const modules = ["Financeiro", "Laboratório", "Comercial", "Estoque", "Compras"];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="NEXUS Enterprise — soluções e gestão operacional." />
    <title>NEXUS Enterprise</title>
    <style>
      :root { font-family: Inter, system-ui, sans-serif; color: #10202e; background: #f5f8fb; }
      body { margin: 0; }
      main { min-height: 100vh; display: grid; place-items: center; padding: 2rem; }
      section { width: min(920px, 100%); }
      span { color: #0879a8; font-weight: 800; letter-spacing: .14em; font-size: .78rem; }
      h1 { max-width: 13ch; margin: .8rem 0 1rem; font-size: clamp(3rem, 8vw, 7rem); line-height: .95; }
      p { max-width: 62ch; color: #526577; line-height: 1.7; }
      ul { display: flex; flex-wrap: wrap; gap: .7rem; padding: 0; list-style: none; }
      li { padding: .65rem .9rem; border: 1px solid #cad7e1; border-radius: 999px; background: white; }
    </style>
  </head>
  <body>
    <main>
      <section>
        <span>NEXUS ENTERPRISE</span>
        <h1>Gestão técnica com rastreabilidade.</h1>
        <p>Estrutura inicial do site institucional. Conteúdo, SEO, formulário e identidade visual serão definidos na fase de publicação.</p>
        <ul>{modules.map((module) => <li>{module}</li>)}</ul>
      </section>
    </main>
  </body>
</html>
